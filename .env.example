# Copy to .env.local and fill in. Never commit real values.
# The server refuses to start if any required variable is missing or invalid.

# MongoDB Atlas — connection string from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=hanslistenia

# AWS — IAM user limited to the two buckets below
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Private: SINPE receipt screenshots (presigned URLs only)
S3_RECEIPTS_BUCKET=
# Public-read: product images
S3_PRODUCTS_BUCKET=

# Admin login — generate all three with: npm run admin:credentials
# (the password itself is never stored; give it to the admin separately)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Signs the admin session cookie; at least 32 random characters
SESSION_SECRET=

# Optional: debug | info | warn | error (default: info)
LOG_LEVEL=info
