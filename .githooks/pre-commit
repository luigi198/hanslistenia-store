#!/bin/sh
# Blocks the commit if ESLint fails (code quality + layer-boundary rules).
# Installed by `npm install` (see "prepare" in package.json).
# Skip once in an emergency with: git commit --no-verify

echo "pre-commit: npm run lint"
if ! npm run --silent lint; then
  echo "pre-commit: ESLint failed. Fix the errors above, then commit again."
  exit 1
fi
